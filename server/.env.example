# Port number for the Express server
PORT=5001

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/task_manager?retryWrites=true&w=majority

# Secret key used for signing JWT authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# Token expiration duration
JWT_EXPIRE=7d

# Allowed frontend origin URL for CORS requests
CLIENT_URL=http://localhost:5173

# Runtime environment (development or production)
NODE_ENV=development
